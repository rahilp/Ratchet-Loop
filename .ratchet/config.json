{
  "human_review": "end",
  "host_provider": "auto",
  "ui_reviewers": {
    "visual": [
      "gemini",
      "claude",
      "codex"
    ],
    "behavior": [
      "claude",
      "gemini",
      "codex"
    ]
  },
  "regression_command": "for t in tests/test_*.py; do python3 \"$t\" > /tmp/rt-$(basename $t).log 2>&1 || { echo \"FAIL $t\"; tail -20 /tmp/rt-$(basename $t).log; exit 1; }; done",
  "commit_per_checkpoint": true,
  "design_md": "DESIGN.md",
  "standards": [
    ".ratchet/standards.md"
  ],
  "app": {
    "start_command": null,
    "url": null,
    "healthcheck": null
  },
  "review_depth": {
    "low": [
      "host-both"
    ],
    "normal": [
      "host-standards",
      [
        "codex-correctness",
        "gemini-correctness",
        "claude-correctness",
        "copilot-correctness"
      ]
    ],
    "high": [
      "host-standards",
      "host-correctness",
      [
        "codex-correctness",
        "gemini-correctness",
        "claude-correctness",
        "copilot-correctness"
      ],
      [
        "gemini-standards",
        "claude-standards",
        "codex-standards",
        "copilot-standards"
      ]
    ]
  },
  "providers": [
    {
      "id": "codex",
      "preset": "codex"
    },
    {
      "id": "gemini",
      "preset": "gemini"
    },
    {
      "id": "claude",
      "preset": "claude"
    }
  ],
  "test_timeout_sec": 3600,
  "max_adversarial_rounds_run": 60,
  "spec_keep": true
}
