{
 "name": "guard",
 "description": "Covers the guard's shell check (_guard_shell) only. Refusals of commands that set reserved variables (RATCHET_HUMAN_OVERRIDE, RATCHET_ROLE, RATCHET_HOME, RATCHET_DIRECTOR_KEY_FILE) come from the hook layer (decide_guard), which this table does not run, so a clean result does not show they hold. Watches spec_sources.py and provider_health.py as well as ratchet.py because the engine imports both and the comparison copy cannot load without them.",
 "watches": ["skills/ratchet-orchestrator/scripts/ratchet.py", "skills/ratchet-orchestrator/scripts/spec_sources.py", "skills/ratchet-orchestrator/scripts/provider_health.py", "skills/ratchet-orchestrator/scripts/engine_utils.py", "skills/ratchet-orchestrator/scripts/fingerprint.py", "skills/ratchet-orchestrator/scripts/records.py", "skills/ratchet-orchestrator/scripts/provider_discovery.py", "skills/ratchet-orchestrator/scripts/run_records.py", "skills/ratchet-orchestrator/scripts/plan_support.py", "skills/ratchet-orchestrator/scripts/status_text.py"],
 "runner": "python3 tests/shortcuts/guard_runner.py",
 "rows": [
  {"id": "probe-plain-redirect", "command": "echo x > .ratchet/runs/hk/state.json", "expect": "refused", "source": "director probe"},
  {"id": "probe-quoted-redirect", "command": "jq . /tmp/s > \".ratchet/runs/hk/state.json\"", "expect": "refused", "source": "director probe"},
  {"id": "probe-1-redirect", "command": "cat x 1> .ratchet/runs/hk/state.json", "expect": "refused", "source": "director probe"},
  {"id": "probe-2-redirect", "command": "cat /tmp/new.json 2> .ratchet/runs/hk/state.json", "expect": "refused", "source": "director probe"},
  {"id": "probe-amp-redirect", "command": "jq . /tmp/new.json &> .ratchet/runs/hk/state.json", "expect": "refused", "source": "director probe"},
  {"id": "probe-tee", "command": "cat /tmp/n | tee .ratchet/runs/hk/state.json", "expect": "refused", "source": "director probe"},
  {"id": "probe-process-subst-tee", "command": "cat README.md > >(tee .ratchet/runs/hk/state.json)", "expect": "refused", "source": "director probe"},
  {"id": "probe-uniq-stdin", "command": "cat /tmp/new | uniq - .ratchet/runs/hk/state.json", "expect": "refused", "source": "director probe"},
  {"id": "probe-cp-t", "command": "cp -t .ratchet/runs/hk /tmp/state.json", "expect": "refused", "source": "director probe"},
  {"id": "probe-cp-rt", "command": "cp -rt .ratchet/runs/hk /tmp/state.json", "expect": "refused", "source": "director probe"},
  {"id": "probe-while-read", "command": "find .ratchet/runs -name state.json | while read f; do echo x > \"$f\"; done", "expect": "refused", "source": "director probe"},
  {"id": "probe-sed-i", "command": "sed -i s/a/b/ .ratchet/runs/hk/state.json", "expect": "refused", "source": "director probe"},
  {"id": "probe-python-write", "command": "python3 -c \"open('.ratchet/runs/hk/state.json','w').write('x')\"", "expect": "refused", "source": "director probe"},
  {"id": "probe-read-cat", "command": "cat .ratchet/runs/hk/state.json", "expect": "allowed", "source": "director probe"},
  {"id": "probe-read-grep", "command": "grep -r PASS .ratchet/runs/hk/evidence", "expect": "allowed", "source": "director probe"},
  {"id": "probe-read-ls", "command": "ls -la .ratchet/runs/hk", "expect": "allowed", "source": "director probe"},
  {"id": "probe-read-diff", "command": "diff .ratchet/runs/hk/state.json /tmp/state.copy.json", "expect": "allowed", "source": "director probe"},
  {"id": "probe-read-test-f", "command": "test -f .ratchet/runs/hk/state.json", "expect": "allowed", "source": "director probe"},
  {"id": "probe-read-python", "command": "python3 -c \"print(open('.ratchet/runs/hk/state.json').read())\"", "expect": "allowed", "source": "director probe"},
  {"id": "dogfood-heredoc-to-tmp", "command": "cat > /tmp/note.md <<'EOF'\nthe phase is in .ratchet/runs/hk/state.json\nEOF", "expect": "allowed", "source": "dogfood log"},
  {"id": "writes-t01-append-fd1-other", "command": "cat /tmp/new.json 1>> .ratchet/runs/other/state.json", "expect": "refused", "source": "tests/test_guard_writes.py CP4-T01"},
  {"id": "writes-t01-clobber", "command": "cat /tmp/new.json >| .ratchet/runs/hk/state.json", "expect": "refused", "source": "tests/test_guard_writes.py CP4-T01"},
  {"id": "writes-t03-uniq-two-operands", "command": "uniq /tmp/new.json .ratchet/runs/hk/state.json", "expect": "refused", "source": "tests/test_guard_writes.py CP4-T03"},
  {"id": "writes-t04-for-loop", "command": "for v in .ratchet/runs/hk/evidence/CP1/*.json; do echo x > \"$v\"; done", "expect": "refused", "source": "tests/test_guard_writes.py CP4-T04"},
  {"id": "writes-t07-stderr-null", "command": "jq . .ratchet/runs/hk/state.json 2>/dev/null", "expect": "allowed", "source": "tests/test_guard_writes.py CP4-T07"},
  {"id": "writes-t08-copy-to-tmp", "command": "cat .ratchet/runs/hk/state.json > /tmp/s.json", "expect": "allowed", "source": "tests/test_guard_writes.py CP4-T08"},
  {"id": "reads-t04-sed-n", "command": "sed -n '1,5p' .ratchet/runs/hk/state.json", "expect": "allowed", "source": "tests/test_guard_reads.py CP2-T04"},
  {"id": "reads-t08-echo-to-tmp", "command": "echo 'see .ratchet/runs/hk/state.json' > /tmp/note.txt", "expect": "allowed", "source": "tests/test_guard_reads.py CP2-T08"},
  {"id": "reads-t09-commit-message", "command": "git commit -m 'guard: block writes to .ratchet/runs/hk/state.json'", "expect": "allowed", "source": "tests/test_guard_reads.py CP2-T09"},
  {"id": "pyreads-t01-cd-python-read", "command": "cd .ratchet/runs/hk && python3 -c \"import json; d=json.load(open('state.json')); print(d['phase'])\"", "expect": "allowed", "source": "tests/test_guard_python_reads.py CP3-T01"},
  {"id": "pyreads-t06-append-log", "command": "python3 -c \"open('.ratchet/human_log.jsonl', 'a').write('{}\\n')\"", "expect": "refused", "source": "tests/test_guard_python_reads.py CP3-T06"},
  {"id": "reserved-t02-printf-note", "command": "printf '%s\\n' \"RATCHET_HUMAN_OVERRIDE=1 is for humans\" > /tmp/n.md", "expect": "allowed", "source": "tests/test_guard_reserved_names.py CP1-T02"},
  {"id": "reserved-t02-commit-message", "command": "git commit --allow-empty -m 'guard: refuse export RATCHET_HUMAN_OVERRIDE=1'", "expect": "allowed", "source": "tests/test_guard_reserved_names.py CP1-T02"}
 ]
}
